# ============================================================
#  Variables de entorno para docker-compose.
#  Copiar este archivo como .env antes de levantar la solucion.
#  Los valores son SOLO para desarrollo local; en otros ambientes
#  deben reemplazarse por secretos generados y guardarse en un vault.
#  Contraseñas de BD: solo letras y numeros, minimo 12 caracteres.
# ============================================================

# PostgreSQL (superusuario: solo lo usa el migrador)
POSTGRES_DB=carga_masiva
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=PgAdminLocal2026x

# Un usuario de base de datos por microservicio (minimo privilegio)
AUTH_DB_PASSWORD=AuthSvcLocal2026x
CONTROL_DB_PASSWORD=ControlSvcLocal2026x
BULKLOAD_DB_PASSWORD=BulkSvcLocal2026x
NOTIFICATION_DB_PASSWORD=NotifSvcLocal2026x

# Usuarios de prueba de la aplicacion (los crea el migrador)
#   admin@cargamasiva.local     -> Administrador (sube archivos, ve todas las cargas)
#   operador@cargamasiva.local  -> Operador (sube archivos, ve sus cargas)
#   consulta@cargamasiva.local  -> Consulta (solo consulta, no puede subir)
SEED_ADMIN_PASSWORD=Admin#2026
SEED_OPERADOR_PASSWORD=Operador#2026
SEED_CONSULTA_PASSWORD=Consulta#2026

# RabbitMQ
RABBITMQ_USER=carga_masiva
RABBITMQ_PASSWORD=RabbitLocal2026x

# JWT: clave de firma HS256, minimo 32 caracteres
JWT_KEY=Ks8vQ2mXr7LpW4nZt9YbC3eF6hJ1aD5gUo0iR8sTq2Vw

# Tamaño maximo del Excel en MB
UPLOAD_MAX_FILE_SIZE_MB=10

# Correo remitente de las notificaciones
SMTP_FROM_ADDRESS=no-reply@cargamasiva.local
