{
  "info": {
    "name": "Carga Masiva - Microservicios",
    "description": "Peticiones al API Gateway (http://localhost:5000). Ejecutar primero 'Login' para guardar el JWT en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "idCarga",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Administrador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el JWT (15 min) y el refresh token. Los guarda en las variables de la colección.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargamasiva.local\",\n  \"password\": \"Admin#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Operador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operador@cargamasiva.local\",\n  \"password\": \"Operador#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Consulta - sin permiso de carga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"consulta@cargamasiva.local\",\n  \"password\": \"Consulta#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargamasiva.local\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Usa la cookie HttpOnly 'refresh_token' que dejó el login (Postman la envía sola). Rota el refresh token.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Cargas",
      "item": [
        {
          "name": "Subir Excel",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas"
              ]
            },
            "description": "Seleccionar en 'archivo' uno de los Excel de la carpeta samples. Responde 202 con el idCarga en estado Pendiente.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Aceptado', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('idCarga', pm.response.json().idCarga);"
                ]
              }
            }
          ]
        },
        {
          "name": "Historial de cargas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Detalle y trazabilidad de una carga",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas/{{idCarga}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas",
                "{{idCarga}}"
              ]
            },
            "description": "Estado actual, resultado, contadores e historial de estados (auditoría)."
          }
        },
        {
          "name": "Contenido cargado (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas/{{idCarga}}/registros?pagina=1&tamano=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas",
                "{{idCarga}}",
                "registros"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "tamano",
                  "value": "50"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Registros no cargados (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas/{{idCarga}}/fallidos?pagina=1&tamano=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas",
                "{{idCarga}}",
                "fallidos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "tamano",
                  "value": "50"
                }
              ]
            },
            "description": "Motivos: Existente, DatoInvalido, PeriodoRechazado."
          }
        },
        {
          "name": "Descargar Excel original",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas/{{idCarga}}/archivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas",
                "{{idCarga}}",
                "archivo"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cargas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cargas"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}