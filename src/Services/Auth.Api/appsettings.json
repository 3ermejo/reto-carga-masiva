{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "Jwt": {
    "Issuer": "carga-masiva-auth",
    "Audience": "carga-masiva-api",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieSecure": true
  },
  "Seguridad": {
    "MaxIntentosFallidos": 5,
    "MinutosBloqueo": 15
  }
}
