{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "carga-masiva-auth",
    "Audience": "carga-masiva-api",
    "Key": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "GeneralPermitLimit": 120,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "cargas-route": {
        "ClusterId": "control-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/cargas/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api:8080/"
          }
        }
      },
      "control-cluster": {
        "Destinations": {
          "control-api": {
            "Address": "http://control-api:8080/"
          }
        }
      }
    }
  }
}
