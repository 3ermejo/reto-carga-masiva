{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ControlDb": ""
  },
  "Jwt": {
    "Issuer": "carga-masiva-auth",
    "Audience": "carga-masiva-api",
    "Key": ""
  },
  "Upload": {
    "MaxFileSizeMB": 10
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "ClientName": "control-api"
  },
  "SeaweedFs": {
    "FilerUrl": "http://seaweedfs:8888/"
  }
}
