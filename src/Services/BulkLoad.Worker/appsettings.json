{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "ConnectionStrings": {
    "BulkLoadDb": ""
  },
  "Procesamiento": {
    "MaxFilas": 100000,
    "MaxArchivoMB": 20
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "ClientName": "bulkload-worker"
  },
  "SeaweedFs": {
    "FilerUrl": "http://seaweedfs:8888/"
  }
}
